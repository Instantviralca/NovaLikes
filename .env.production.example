# NovaLikes — Production Environment Template (Contabo Ubuntu VPS)
# =============================================================================
# Copy to the server as /var/www/novalikes/.env.production (or .env)
# NEVER commit a file that contains real secrets.
#
# Verify:
#   IV_VERIFY_AS_PRODUCTION=1 npm run env:verify
# Runbook:
#   docs/CONTABO_PRODUCTION_DEPLOYMENT.md
# =============================================================================

# ── Site (REQUIRED FOR LAUNCH) ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://novalikes.com
SITE_URL=https://novalikes.com

# Cart/checkout/order-success/track-order are same-origin on novalikes.com.
# Do not set a NovaLikes checkout subdomain. NEXT_PUBLIC_CHECKOUT_URL is ignored.

# ── Database (REQUIRED FOR LAUNCH) ───────────────────────────────────────────
# Same-VPS PostgreSQL. Replace USER/PASSWORD. Do not use a real password here.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/novalikes

# ── Admin auth (REQUIRED FOR LAUNCH) ─────────────────────────────────────────
# Generate: openssl rand -base64 32
IV_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# Generate: openssl rand -hex 64
IV_ADMIN_SESSION_SECRET=CHANGE_ME_64_PLUS_CHAR_SESSION_SECRET
NEXT_PUBLIC_ADMIN_AUTH_CONFIGURED=true

# ── Cart recovery ────────────────────────────────────────────────────────────
CART_ABANDONMENT_MINUTES=20
CART_RECOVERY_RETENTION_DAYS=90
CART_RECOVERY_TOKEN_PEPPER=CHANGE_ME_LONG_RANDOM_TOKEN_PEPPER
CRON_SECRET=CHANGE_ME_LONG_RANDOM_CRON_SECRET
# Set to 1 during a safe rollout to record sends without delivering email.
IV_CART_RECOVERY_DRY_RUN=1

# ── Mollie Remote Payment (REQUIRED FOR CHECKOUT; Admin → Settings can override)
REMOTE_PAYMENT_WEBSITE_URL=https://carrycubes.com
REMOTE_PAYMENT_SHARED_SECRET=CHANGE_ME_MATCH_MOLLIE_SERVER_SECRET
# REMOTE_PAYMENT_PRODUCT_NAME=Cubes

# ── Email (OPTIONAL until mail phase; order emails skip until configured) ────
# Self-hosted Postfix later (no SMTP auth required for trusted localhost relay):
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=NovaLikes <orders@novalikes.com>
EMAIL_REPLY_TO=support@novalikes.com
ADMIN_EMAIL=ops@novalikes.com
EMAIL_ADMIN_TO=ops@novalikes.com
EMAIL_SUPPORT=support@novalikes.com
EMAIL_COMPANY_NAME=NovaLikes
# Optional SaaS fallback (do not require both):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# ── CMS media (local filesystem on this VPS) ────────────────────────────────
CMS_MEDIA_DIR=/var/lib/novalikes/cms-media
CMS_MEDIA_PUBLIC_BASE_URL=/api/cms/media/file
CMS_PUBLISH_LOCK_PATH=/var/lock/novalikes-publish-scheduled.lock

# ── Tools HMAC (OPTIONAL; falls back to IV_ADMIN_SESSION_SECRET) ────────────
TOOLS_MEDIA_SECRET=CHANGE_ME_TOOLS_HMAC_SECRET

# ── Learn preview (OPTIONAL) ────────────────────────────────────────────────
LEARN_ARTICLE_PREVIEW_SECRET=CHANGE_ME_PREVIEW_SECRET

# ── Analytics (OPTIONAL) ────────────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_ANALYTICS_DEBUG=false
# NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=required
# NEXT_PUBLIC_GA4_ENABLED=false
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ENABLED=false
# NEXT_PUBLIC_GTM_CONTAINER_ID=
# NEXT_PUBLIC_CLARITY_ENABLED=false
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Optional Stripe (paused — Mollie is the live checkout provider) ──
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Geo block (PK, IN, BD, NG) — leave enabled in production ────────────────
# IV_GEO_BLOCK_DISABLED=1

# ── Do NOT set in production ────────────────────────────────────────────────
# IV_PAYMENTS_MODE=mock
# IV_ALLOW_FILE_STORE=1
# IV_SKIP_ENV_GUARD=1
# IV_PERSISTENCE=memory
# CMS_STORE_PATH=
