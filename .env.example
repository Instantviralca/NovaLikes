# Environment placeholders (fill in for local/production)
# Never commit .env.local
# Full runbook: DEPLOYMENT.md

# ── Site (HTTPS required in production) ───────────────
# NEXT_PUBLIC_SITE_URL=https://novalikes.com
# SITE_URL=https://novalikes.com

# Site URLs (HTTPS required in production)
# NEXT_PUBLIC_SITE_URL=https://novalikes.com
# SITE_URL=https://novalikes.com

# Cart, checkout, order-success and track-order live on the main site:
#   https://novalikes.com/cart
#   https://novalikes.com/checkout
#   https://novalikes.com/order-success
#   https://novalikes.com/track-order
# Do not set a NovaLikes checkout subdomain. NEXT_PUBLIC_CHECKOUT_URL is ignored.

# ── Database (PostgreSQL / Neon / Supabase) ───────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Dev-only file store fallback (never in production)
# IV_ALLOW_FILE_STORE=1

# Force in-memory persistence (tests)
# IV_PERSISTENCE=memory

# ── Admin auth ────────────────────────────────────────
# Prefer strong unique values in production (aliases: ADMIN_PASSWORD, SESSION_SECRET)
# IV_ADMIN_PASSWORD=
# IV_ADMIN_SESSION_SECRET=
# IV_SHARED_SECRET=
# NEXT_PUBLIC_ADMIN_AUTH_CONFIGURED=true

# ── Remote payment (Admin → Settings preferred) ───────
# REMOTE_PAYMENT_WEBSITE_URL=https://your-payment-collector.com
# Local mock payments (non-production only):
# IV_PAYMENTS_MODE=mock

# ── Email (SMTP self-hosted later, or Resend) ─────────
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=orders@your-verified-domain.com
# EMAIL_REPLY_TO=support@your-verified-domain.com
# ADMIN_EMAIL=ops@your-verified-domain.com
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=orders@your-verified-domain.com   # alias for EMAIL_FROM
# EMAIL_SUPPORT=support@your-verified-domain.com
# EMAIL_ADMIN_TO=ops@your-verified-domain.com
# EMAIL_COMPANY_NAME=NovaLikes

# ── Analytics — Document 14.09 ────────────────────────
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_ANALYTICS_DEBUG=false
# NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=required
# NEXT_PUBLIC_GA4_ENABLED=false
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ENABLED=false
# NEXT_PUBLIC_GTM_CONTAINER_ID=
# NEXT_PUBLIC_CLARITY_ENABLED=false
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Learn article preview (authorized editors only — Document 15.02)
# LEARN_ARTICLE_PREVIEW_SECRET=

# Author Dashboard / CMS
# Create the first author with:
#   CMS_AUTHOR_NAME=Jane CMS_AUTHOR_EMAIL=jane@novalikes.com CMS_AUTHOR_PASSWORD=... npm run author:create
# CMS_MEDIA_DIR=
# CMS_MEDIA_PUBLIC_BASE_URL=/api/cms/media/file
# TOOLS_MEDIA_SECRET=
# CMS_PUBLISH_LOCK_PATH=

# Skip production env throw during instrumentation (CI / build only)
# IV_SKIP_ENV_GUARD=1

# Geo block (PK, IN, BD, NG) — disable for local/preview if needed
# IV_GEO_BLOCK_DISABLED=1

# Marketing email campaigns use the same Resend keys (RESEND_API_KEY / EMAIL_FROM).
# After deploy, run drizzle/0004_email_subscribers.sql on Neon, then create SAVE25 in Admin → Coupons.
